#!/bin/sh
# Post-removal for mihomo-manifold.
set -e

CORE=/usr/lib/mihomo-manifold/mihomo
RULE=/etc/polkit-1/rules.d/49-mihomo-manifold.rules

case "$1" in
    remove|upgrade|deconfigure)
        # The file is on its way out and the capabilities live in its xattr, so
        # there is nothing to undo. Clearing it anyway is cheap insurance for
        # the case where dpkg is keeping the file around.
        [ -e "$CORE" ] && command -v setcap >/dev/null 2>&1 \
            && setcap -r "$CORE" 2>/dev/null || true
        # The polkit rule was written by the app at the user's request, not by
        # this package, so `remove` leaves it: the user may still have a config
        # to go with. Only a purge takes it away.
        ;;
    purge)
        if [ -e "$RULE" ]; then
            rm -f "$RULE" && echo "mihomo-manifold: removed $RULE"
        fi
        ;;
esac

exit 0
