# Rust build output.
/target

# Packaging output. build-deb.sh stages everything here: the .deb, the rendered
# icons under .build/icons, and the pinned core it downloads. Never commit any
# of it — the core alone is 60 MB.
/result
/result-*
/.build
*.deb

# Written at the repo root by the payload assertions in the build workflow and
# by the same checks when reproduced locally (docs/packaging/debian.md).
package-contents.txt

# IDE / agent internal state (plans, sessions, scratch).
/.zcode

# Editor and OS cruft.
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Local environment overrides.
.env
.env.local
